# Copy this file to .local.env and fill in your values.
# .local.env is gitignored — never commit credentials.

# ---- Required ----
BSKY_HANDLE=snowbot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Storage ----
DB_PATH=data/snowbot.db

# ---- File alert channel ----
INBOX_PATH=inbox
INBOX_ARCHIVE_PATH=inbox/archive
INBOX_ERROR_PATH=inbox/errors
INBOX_POLL_INTERVAL_SEC=5.0

# ---- Logging ----
LOG_PATH=logs/snowbot.log
LOG_LEVEL=INFO

# ---- Snow data ----
SNOW_CACHE_TTL_MINUTES=30

# ---- SnoCountry API (optional) ----
# Enables resort-reported conditions (base depth, lifts, trails, surface).
# Contact andrew.davis@snocountry.org or 603-443-8823 to obtain a key.
# Leave blank to use Open-Meteo estimates only.
SNOCOUNTRY_KEY=

# Set SNOCOUNTRY_MOCK=true to use synthetic data during development
# (no API key required; ignored when SNOCOUNTRY_KEY is set).
SNOCOUNTRY_MOCK=false

# ---- Photos ----
# Local directory containing snow photos (not stored in git).
# Defaults to snowbot/data/photos if unset.
# PHOTOS_PATH=/Users/you/photos/snowbot

# ---- DM polling ----
# Adaptive polling: check every DM_POLL_INTERVAL_SEC when idle; after a DM
# arrives, check every DM_POLL_ACTIVE_INTERVAL_SEC until no new DM has come in
# for DM_POLL_ACTIVE_WINDOW_SEC, then drop back to idle.
# Bluesky allows 3000 chat requests/5min — 1s polling uses ~10% of that limit.
DM_POLL_INTERVAL_SEC=5
DM_POLL_ACTIVE_INTERVAL_SEC=1
DM_POLL_ACTIVE_WINDOW_SEC=120

# ---- DM session ----
# How long (minutes) a menu navigation session stays active between messages.
DM_SESSION_TTL_MINUTES=30

# ---- Server identification (shown in latency footer) ----
# laptop | Pi
SERVER_TYPE=laptop

# ---- Admin alerts (optional) ----
# Bluesky handle that gets a DM with the error details whenever a request fails
# (e.g. "snow data is temporarily unavailable"). Throttled per error type.
ADMIN_HANDLE=

# ---- Background refresh ----
# Refresh every resort's report this often (minutes); 0 turns it off
SNOW_REFRESH_MINUTES=60
