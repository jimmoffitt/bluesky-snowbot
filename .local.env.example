# Copy this file to .local.env and fill in your values.
# .local.env is gitignored — never commit credentials.

# ---- Required ----
BSKY_HANDLE=snowbot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Storage ----
DB_PATH=data/snowbot.db

# ---- File alert channel ----
INBOX_PATH=inbox
INBOX_ARCHIVE_PATH=inbox/archive
INBOX_ERROR_PATH=inbox/errors
INBOX_POLL_INTERVAL_SEC=5.0

# ---- Logging ----
LOG_PATH=logs/snowbot.log
LOG_LEVEL=INFO

# ---- Snow data ----
SNOW_CACHE_TTL_MINUTES=30

# ---- SnoCountry API (optional) ----
# Enables resort-reported conditions (base depth, lifts, trails, surface).
# Contact andrew.davis@snocountry.org or 603-443-8823 to obtain a key.
# Leave blank to use Open-Meteo estimates only.
SNOCOUNTRY_KEY=

# Set SNOCOUNTRY_MOCK=true to use synthetic data during development
# (no API key required; ignored when SNOCOUNTRY_KEY is set).
SNOCOUNTRY_MOCK=false

# ---- DM session ----
# How long (minutes) a menu navigation session stays active between messages.
DM_SESSION_TTL_MINUTES=30

# ---- Server identification (shown in latency footer) ----
# laptop | Pi
SERVER_TYPE=laptop
