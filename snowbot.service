[Unit]
Description=Snowbot — Bluesky snow resort conditions bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jim
WorkingDirectory=/home/jim/projects/bluesky-snowbot
ExecStart=/home/jim/projects/bluesky-snowbot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=snowbot

# Environment file with BSKY_HANDLE, BSKY_APP_PASSWORD, etc.
EnvironmentFile=/home/jim/projects/bluesky-snowbot/.local.env

[Install]
WantedBy=multi-user.target
